// Neon Postgres — dev branch locally, main branch on Vercel.
// Set DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct) in .env.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  githubId     String   @unique
  githubLogin  String
  accessToken  String // GitHub OAuth token, used for API calls on their behalf
  createdAt    DateTime @default(now())

  repos         TrackedRepo[]
  notifications Notification[]
}

model TrackedRepo {
  id                  String    @id @default(cuid())
  owner               String
  name                String
  addedAt             DateTime  @default(now())
  lastPolledAt        DateTime?
  lastSeenIssueNumber Int       @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@unique([userId, owner, name])
}

model Notification {
  id                String   @id @default(cuid())
  issueNumber       Int
  issueUrl          String
  title             String
  authorLogin       String
  authorAssociation String // OWNER | MEMBER | COLLABORATOR | CONTRIBUTOR
  createdAt         DateTime @default(now())
  read              Boolean  @default(false)

  repoId String
  repo   TrackedRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repoId, issueNumber])
}
