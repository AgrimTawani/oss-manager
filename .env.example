# Neon Postgres — use dev branch for local, main branch for Vercel production.
# Pooled URL (-pooler hostname) for app runtime (serverless / web).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct URL (no -pooler suffix) for Prisma migrations only.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# GitHub OAuth App — https://github.com/settings/developers
# Local callback: http://localhost:3000/api/auth/callback/github
# Prod callback:  https://your-app.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# NextAuth session encryption. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Shared secret for POST /api/poll (GitHub Actions cron or manual curl).
POLL_SECRET=""

# --- Production only (set in Vercel dashboard, not local .env) ---
# NEXTAUTH_URL=https://your-app.vercel.app
# GitHub Actions repo secrets: APP_URL=https://your-app.vercel.app, POLL_SECRET=<same as Vercel>
