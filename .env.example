# Database. Defaults to SQLite — works with zero setup.
# For Postgres, change the provider in prisma/schema.prisma to "postgresql"
# and put your connection string here instead.
DATABASE_URL="file:./dev.db"

# GitHub OAuth App credentials.
# Create one at https://github.com/settings/developers -> "New OAuth App"
# Homepage URL: http://localhost:3000 (or your deployed URL)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# NextAuth session encryption secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Shared secret required to call POST /api/poll (used by the GitHub Action
# or your own cron job). Generate any random string.
POLL_SECRET=""
